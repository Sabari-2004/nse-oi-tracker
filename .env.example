# Runtime persistence. Relative paths are resolved from the repository root.
NSE_OI_DATA_DIR=data
NSE_OI_DATABASE=nse_oi_tracker.sqlite3

# One-process scheduler cadence. Keep at or above 60 seconds unless public NSE
# source limits and endpoint behavior have been revalidated.
NSE_OI_POLL_INTERVAL_SECONDS=60
NSE_OI_CACHE_TTL_SECONDS=60
NSE_OI_HISTORY_RETENTION_DAYS=30
# Automatically backfill missing daily equity history on a fresh Render boot.
NSE_OI_STARTUP_BACKFILL=1

# The bundled dashboard is same-origin, so leave blank by default. For a
# separate dashboard, provide exact allowed origins, comma separated.
NSE_OI_CORS_ORIGINS=

# Optional, opt-in candidate-observation alerts. Leave both blank to disable
# all outbound notifications. Alerts say NO_TRADE until validation is built.
NSE_OI_ALERT_WEBHOOK_URL=
NSE_OI_NTFY_TOPIC_URL=
# Telegram Bot API is free but requires a BotFather token and the destination
# chat id. Set both together; leave both blank to disable Telegram delivery.
NSE_OI_TELEGRAM_BOT_TOKEN=
NSE_OI_TELEGRAM_CHAT_ID=
NSE_OI_ALERT_MIN_CONFIDENCE=80

# Leave blank to disable /api/debug entirely. Use a long random value only in
# trusted environments; never commit a populated .env file.
DEBUG_TOKEN=

# Optional read-only Angel One market data. These values are used only for
# quotes/candles; this project intentionally has no order/GTT API integration.
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=
ANGEL_SYMBOL_TOKENS={}
# Full Angel quote overlay is disabled by default to fit Render Free's 512 MB
# memory limit. Enable only on a deployment with a larger memory budget.
ANGEL_OVERLAY_ENABLED=0

# Optional gzip SQLite snapshots for Render Free (S3-compatible/Supabase endpoint)
NSE_OI_BACKUP_URL=
NSE_OI_BACKUP_TOKEN=
